[sub_resource type="GDScript" id="GDScript_eqa6y"]
script/source = "extends Node2D


var folderPath = \"Slides/\"
var parent = null

func ready() -> void:
	parent.connect(\"init\",init)
	
func init():
	pass
	#addAnimsRepeat([\"slide1\",\"slide2\",\"slide4\",\"slide5\",\"slide6\",\"slide7\",\"slide8\",\"slide9\"])

func addAnimsRepeat(anims:Array):
	var curFrames = []
	for item in anims:
		curFrames = parent.getFilesInFolder(folderPath + item)
		var node = get_node(item)
		if node:
			node.sprite_frames = parent.getSpriteFrameFromFiles(curFrames)
			node.play(\"default\")
		else:
			print(\"COULDNT FIND NODE %s\" %[item])
"

