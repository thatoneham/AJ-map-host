[sub_resource type="GDScript" id="GDScript_ufvfu"]
resource_name = "Water"
script/source = "extends Node2D

signal water(node,area)
signal water_exit(node,area)
func _ready():
	for child in get_children():
		(child as Area2D).body_entered.connect(emit.bind(child))
		(child as Area2D).body_exited.connect(emit_exit.bind(child))

func emit(node,area):
	print(\"DETECTED SOMETHING\")
	emit_signal(\"water\",node,area)
func emit_exit(node,area):
	emit_signal(\"water_exit\",node,area)
"

