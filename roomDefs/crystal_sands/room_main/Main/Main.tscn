[sub_resource type="GDScript" id="GDScript_d7h7d"]
resource_name = "Main"
script/source = "extends Node2D

var mainPath = \"user://RoomData/Main/Assets/\"
var data = {\"music\":\"MusCrystalSands.mp3\",\"musicVol\":80,\"name\":\"Crystal Sands\",\"denCatId\":0}
signal init
func ready() -> void:
	#emit_signal(\"init\")
	get_node(\"Bg\").texture = getTexFromPath(\"cs_bkgrnd.jpg\")
func getFilesInFolder(path):
	path = mainPath + path
	var dir = DirAccess.open(path)
	var tex := []
	if dir:
		dir.list_dir_begin()
		var file_name = dir.get_next()
		while file_name != \"\":
			if not dir.current_is_dir() and not file_name.ends_with(\".import\"):
				tex.append(path + \"/\" + file_name)
			file_name = dir.get_next()
		dir.list_dir_end()
	return tex
func sortByfileName(a:String,b:String):
	var path = a.split(\"/\")[-1]
	var num_a = int(a.split(\"/\")[-1])
	var num_b = int(b.split(\"/\")[-1])
	
	return num_a < num_b
func getTexFromPath(path):
	return ImageTexture.create_from_image(Image.load_from_file(mainPath + path))

func getSpriteFrameFromFiles(files:Array) -> SpriteFrames:
	files.sort_custom(sortByfileName)
	var textur := SpriteFrames.new()
	var frame = 0
	if not textur.has_animation(\"default\"):
		textur.add_animation(\"default\")
	textur.set_animation_speed(\"default\",24)
	textur.set_animation_loop(\"default\",true)
	for tex in files:
		print(\"FILE EXISTS %s AND PATH %s\" % [DirAccess.dir_exists_absolute(tex),tex])
		var img = Image.load_from_file(tex)
		textur.add_frame(\"default\",ImageTexture.create_from_image(img))
		frame += 1
	return textur

func getTexFromFiles(files:Array):
	files.sort_custom(sortByfileName)
	var textur := AnimatedTexture.new()
	var frame = 0
	textur.frames = files.size()
	textur.speed_scale = 24
	for tex in files:
		var img = Image.load_from_file(tex)
		textur.set_frame_texture(frame,ImageTexture.create_from_image(img))
		frame += 1
	return textur
"

[sub_resource type="GDScript" id="GDScript_vsies"]
resource_name = "textureSet"
script/source = "extends Node2D


var folderPath = \"YSort/\"
var inYsort = true
var parent = null

func ready() -> void:
	parent.connect(\"init\",init)
	
func init():
	get_node(\"tier_aqua_1\").texture = parent.getTexFromPath(folderPath + \"tier_aqua_1.png\")
	get_node(\"tier_bush\").texture = parent.getTexFromPath(folderPath + \"tier_bush.png\")
	get_node(\"hut_1\").texture = parent.getTexFromPath(folderPath + \"hut_1.png\")
	get_node(\"hut_2\").texture = parent.getTexFromPath(folderPath + \"hut_2.png\")
	get_node(\"sign_zios\").texture = parent.getTexFromPath(folderPath + \"sign_zios.png\")
	get_node(\"sign_to_shiveer\").texture = parent.getTexFromPath(folderPath + \"sign_to_shiveer.png\")
	get_node(\"dock_sign_2\").texture = parent.getTexFromPath(folderPath + \"dock_sign_2.png\")
	get_node(\"rock_2\").texture = parent.getTexFromPath(folderPath + \"rock_2.png\")
"

