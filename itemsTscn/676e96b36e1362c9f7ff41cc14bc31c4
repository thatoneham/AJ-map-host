script/source = "
extends Node2D
var versions = [1, 2, 3, 4, 5, 6]

func playVersion(ver:int):
	for child in get_children():
		if child is AnimatedSprite2D:
			if child.sprite_frames.has_animation(str(ver)):
				child.animation = str(ver)
				if child.sprite_frames.get_frame_count(str(ver)) > 0:
					child.frame = 0
func getVersions() -> Array:
	return versions

func setVersion(param1:int):
	if param1 >= getVersions().size():
		playVersion(1)
	else:
		playVersion(param1 + 1)
	"

